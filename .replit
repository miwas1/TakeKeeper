modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GEMINI_MODEL = "gemini-2.5-flash"
GOOGLE_CLOUD_LOCATION = "us-central1"
AGENT_ENGINE_CLASS_METHOD = "query"

[objectStorage]
defaultBucketID = "replit-objstore-1f83a287-7326-4871-855e-fa53adb8d1bf"
